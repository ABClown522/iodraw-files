        </mxCell>
        <mxCell id="create_purchase" value="创建采购单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" parent="lane1" vertex="1">
          <mxGeometry x="180" y="70" width="100" height="40" as="geometry" />
