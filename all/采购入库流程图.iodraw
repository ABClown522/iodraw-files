        <mxCell id="fill_info" value="填写商品、数量、&#xa;供应商等信息" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" parent="lane1" vertex="1">
          <mxGeometry x="320" y="70" width="120" height="40" as="geometry" />
