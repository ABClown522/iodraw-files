        </mxCell>
        <mxCell id="save_purchase" value="保存采购单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="lane3" vertex="1">
          <mxGeometry x="480" y="30" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="save_instore" value="保存入库单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="lane3" vertex="1">
          <mxGeometry x="600" y="30" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="update_inventory" value="增加商品库存" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="lane3" vertex="1">
          <mxGeometry x="740" y="30" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="create_trace" value="生成产品追溯记录" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="lane3" vertex="1">
          <mxGeometry x="880" y="30" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="arrow11" value="" style="endArrow=classic;html=1;strokeWidth=2;" parent="lane3" source="update_inventory" target="create_trace" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
