          <mxGeometry x="180" y="70" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="create_instore" value="创建入库单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" parent="lane2" vertex="1">
