          <mxGeometry x="1140" y="310" width="110" height="55" as="geometry"/>
        </mxCell>

        <!-- 属性 - 右上3 -->
        <mxCell id="attr_buy_price" value="采购价" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1080" y="240" width="110" height="55" as="geometry"/>
        </mxCell>

        <!-- 连接线 -->
        <mxCell id="line1" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_product" target="attr_product_id">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line2" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_product" target="attr_product_name">
          <mxGeometry relative="1" as="geometry"/>
