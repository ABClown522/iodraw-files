        <mxCell id="line12" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_product" target="attr_up_down_state">
          <mxGeometry relative="1" as="geometry"/>
