<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="商品实体属性图">
    <mxGraphModel dx="2000" dy="1100" grid="1" gridSize="10" pageWidth="1600" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 中心实体 product -->
        <mxCell id="entity_product" value="product" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="700" y="400" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- 属性 - 上方 -->
        <mxCell id="attr_product_num" value="商品编号" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="740" y="200" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- 属性 - 上方左 -->
        <mxCell id="attr_product_name" value="商品名称" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="540" y="250" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- 属性 - 上方右 -->
        <mxCell id="attr_product_invent" value="库存数量" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="940" y="250" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- 属性 - 左上 -->
        <mxCell id="attr_product_id" value="商品ID（主键）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- 属性 - 左中上 -->
        <mxCell id="attr_unit_id" value="单位ID（FK）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="280" y="390" width="130" height="65" as="geometry"/>
        </mxCell>

        <!-- 属性 - 左中下 -->
        <mxCell id="attr_place_id" value="产地ID（FK）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="130" height="65" as="geometry"/>
        </mxCell>

        <!-- 属性 - 左下 -->
        <mxCell id="attr_supply_id" value="供应商ID（FK）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="360" y="570" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- 属性 - 下方左 -->
        <mxCell id="attr_store_id" value="仓库ID（FK）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="540" y="640" width="130" height="65" as="geometry"/>
        </mxCell>

        <!-- 属性 - 下方中 -->
        <mxCell id="attr_type_id" value="分类ID（FK）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="720" y="680" width="130" height="65" as="geometry"/>
        </mxCell>

        <!-- 属性 - 下方右 -->
        <mxCell id="attr_product_intro" value="商品图片路径" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="900" y="640" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- 属性 - 右下 -->
        <mxCell id="attr_brand_id" value="品牌ID（FK）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1080" y="570" width="130" height="65" as="geometry"/>
        </mxCell>

        <!-- 属性 - 右中 -->
        <mxCell id="attr_up_down_state" value="0下架 1上架" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1140" y="480" width="130" height="65" as="geometry"/>
        </mxCell>

        <!-- 属性 - 右上 -->
        <mxCell id="attr_member_price" value="会员价" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1160" y="390" width="110" height=55" as="geometry"/>
