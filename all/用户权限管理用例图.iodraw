        <mxCell id="legend_note" value="实线 = 关联关系 | 虚线箭头 = 包含关系(include) | 空心三角箭头 = 泛化关系(继承)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
