        <mxCell id="border" value="用户权限管理系统" style="rounded=1;whiteSpace=wrap;fillColor=none;strokeColor=#000000;fontSize=14;fontStyle=1;verticalAlign=top;arcSize=3;" vertex="1" parent="1">
