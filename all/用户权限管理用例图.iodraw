        <mxCell id="uc_role_state" value="修改角色状态" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="510" width="140" height="70" as="geometry"/>
