<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="用户权限管理用例图">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" pageWidth="1600" pageHeight="1200">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 标题 -->
        <mxCell id="title" value="用户权限管理用例图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="400" height="40" as="geometry"/>
        </mxCell>

        <!-- 系统边界 -->
        <mxCell id="system_boundary" value="仓库管理系统 - 用户权限管理模块" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;fontSize=14;fontStyle=1;verticalAlign=top;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="1000" height="900" as="geometry"/>
        </mxCell>

        <!-- 参与者 -->
        <!-- 普通用户 -->
        <mxCell id="actor_user" value="普通用户" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="300" width="60" height="120" as="geometry"/>
        </mxCell>

        <!-- 管理员 -->
        <mxCell id="actor_admin" value="管理员" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="600" width="60" height="120" as="geometry"/>
        </mxCell>

        <!-- 超级管理员 -->
        <mxCell id="actor_superadmin" value="超级管理员" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="450" width="60" height="120" as="geometry"/>
        </mxCell>

        <!-- 用例 - 用户管理 -->
        <mxCell id="uc_user_list" value="查询用户列表" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="140" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="uc_user_add" value="添加用户" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="140" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="uc_user_update" value="修改用户信息" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="150" width="140" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="uc_user_delete" value="删除用户" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="150" width="140" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="uc_user_state" value="修改用户状态" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="260" width="140" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="uc_user_reset_pwd" value="重置用户密码" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="260" width="140" height="70" as="geometry"/>
        </mxCell>

