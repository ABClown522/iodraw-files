        </mxCell>

        <mxCell id="uc_view_user_auth" value="查看用户已有权限" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="650" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- 用例 - 权限验证 -->
