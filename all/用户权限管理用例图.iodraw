        <!-- 关联关系 - 普通用户 -->
        <mxCell id="link_user_1" value="" style="endArrow=none;html=1;strokeColor=#666666;strokeWidth=1.5;" edge="1" parent="1" source="actor_user" target="uc_view_my_auth">
