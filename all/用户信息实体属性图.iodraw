<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="用户信息实体属性图">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" pageWidth="1400" pageHeight="800">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 中心实体 user_info -->
        <mxCell id="entity_user" value="user_info" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="350" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- 属性 - 上方 -->
        <mxCell id="attr_user_id" value="用户ID（主键）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="250" y="200" width="140" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="attr_user_code" value="用户账号" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="430" y="150" width="120" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="attr_user_name" value="用户姓名" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="590" y="120" width="120" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="attr_user_pwd" value="密码（HMAC加密）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="750" y="150" width="150" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="attr_user_type" value="1超管 2管理员 3普通" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="940" y="200" width="160" height="70" as="geometry"/>
        </mxCell>

        <!-- 属性 - 右侧 -->
        <mxCell id="attr_user_state" value="0未审核 1已审核" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="950" y="350" width="150" height="70" as="geometry"/>
        </mxCell>

        <!-- 属性 - 下方 -->
        <mxCell id="attr_create_by" value="创建人ID" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="480" y="520" width="120" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="attr_status" value="0正常 1已删除" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="640" y="540" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- 属性 - 左侧 -->
        <mxCell id="attr_create_time" value="创建时间" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="250" y="350" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- 连接线 -->
        <mxCell id="line1" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_user" target="attr_user_id">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line2" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_user" target="attr_user_code">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line3" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_user" target="attr_user_name">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line4" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_user" target="attr_user_pwd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line5" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_user" target="attr_user_type">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line6" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_user" target="attr_user_state">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line7" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_user" target="attr_create_by">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line8" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_user" target="attr_status">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line9" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_user" target="attr_create_time">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
