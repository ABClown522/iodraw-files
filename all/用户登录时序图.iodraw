            <mxPoint x="460" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg11" value="11: 存储Token和用户信息" style="endArrow=classic;html=1;strokeWidth=2;fontSize=14;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="460" y="540" as="sourcePoint" />
            <mxPoint x="800" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg12" value="12: 存储成功" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;fontSize=14;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="800" y="570" as="sourcePoint" />
            <mxPoint x="460" y="570" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg13" value="13: 返回Token和用户信息" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;fontSize=14;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="460" y="600" as="sourcePoint" />
            <mxPoint x="270" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg14" value="14: 显示登录成功，跳转首页" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;fontSize=14;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="270" y="630" as="sourcePoint" />
            <mxPoint x="100" y="630" as="targetPoint" />
