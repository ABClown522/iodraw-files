          </mxGeometry>
        </mxCell>
        <mxCell id="msg3" value="3: 验证验证码" style="endArrow=classic;html=1;strokeWidth=2;fontSize=14;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="460" y="260" as="sourcePoint" />
