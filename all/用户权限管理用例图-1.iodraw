<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="用户权限管理用例图">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" pageWidth="1800" pageHeight="1400">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 标题 -->
        <mxCell id="title" value="用户权限管理用例图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="400" height="40" as="geometry"/>
        </mxCell>

        <!-- 系统边界 -->
        <mxCell id="system_boundary" value="用户权限管理系统" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=3;fontSize=16;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="120" width="1100" height="1100" as="geometry"/>
        </mxCell>

        <!-- 参与者 -->
        <!-- 系统管理员 -->
        <mxCell id="actor_admin" value="系统管理员" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#000000;fontSize=14;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="150" y="400" width="80" height="160" as="geometry"/>
        </mxCell>

        <!-- 普通用户 -->
        <mxCell id="actor_user" value="普通用户" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#000000;fontSize=14;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="150" y="850" width="80" height="160" as="geometry"/>
        </mxCell>

        <!-- 用例 - 第一行 -->
        <mxCell id="uc_user_manage" value="用户管理&#xa;(增删改查)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="200" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="uc_assign_role" value="分配角色" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="750" y="200" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="uc_role_manage" value="角色管理&#xa;(增删改查)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="200" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- 用例 - 第二行 -->
        <mxCell id="uc_view_user_role" value="查看用户角色" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="750" y="350" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="uc_view_role_auth" value="分配权限" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="350" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- 用例 - 第三行 -->
        <mxCell id="uc_auth_tree" value="权限管理&#xa;(查询权限)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="500" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- 用例 - 第四行（普通用户） -->
        <mxCell id="uc_user_login" value="用户登录" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="850" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="uc_load_auth_tree" value="查看Token" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="750" y="850" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="uc_verify_token" value="主页信息" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="850" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- 用例 - 辅助功能 -->
        <mxCell id="uc_check_token" value="查询验证码" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="750" y="1000" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="uc_verify_auth" value="验证Token" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="1000" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- 关联关系 - 系统管理员 -->
        <mxCell id="link_admin_1" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="actor_admin" target="uc_user_manage">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="link_admin_2" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="actor_admin" target="uc_assign_role">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="link_admin_3" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="actor_admin" target="uc_role_manage">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="link_admin_4" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="actor_admin" target="uc_auth_tree">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 关联关系 - 普通用户 -->
        <mxCell id="link_user_1" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="actor_user" target="uc_user_login">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="link_user_2" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="actor_user" target="uc_verify_token">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="link_user_3" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="actor_user" target="uc_load_auth_tree">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 包含关系 (include) -->
        <mxCell id="include_1" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;fontSize=12;" edge="1" parent="1" source="uc_assign_role" target="uc_view_user_role">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="include_2" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;fontSize=12;" edge="1" parent="1" source="uc_view_user_role" target="uc_view_role_auth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="include_3" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;fontSize=12;" edge="1" parent="1" source="uc_user_login" target="uc_check_token">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="include_4" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;fontSize=12;" edge="1" parent="1" source="uc_load_auth_tree" target="uc_verify_auth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>


      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
