<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="角色实体属性图">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" pageWidth="1400" pageHeight="700">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 中心实体 role -->
        <mxCell id="entity_role" value="role" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="300" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- 属性 - 上方左 -->
        <mxCell id="attr_role_id" value="角色ID（主键）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="300" y="180" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- 属性 - 上方中左 -->
        <mxCell id="attr_role_name" value="角色名称" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="480" y="120" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- 属性 - 上方中右 -->
        <mxCell id="attr_role_code" value="角色标识" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- 属性 - 上方右 -->
        <mxCell id="attr_role_state" value="1启用 0禁用" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="860" y="180" width="130" height="65" as="geometry"/>
        </mxCell>

        <!-- 属性 - 下方左 -->
        <mxCell id="attr_create_time" value="创建时间" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="380" y="450" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- 属性 - 下方右 -->
        <mxCell id="attr_role_desc" value="角色描述" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="780" y="450" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- 连接线 -->
        <mxCell id="line1" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_role" target="attr_role_id">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line2" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_role" target="attr_role_name">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line3" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_role" target="attr_role_code">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line4" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_role" target="attr_role_state">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line5" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_role" target="attr_create_time">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="line6" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entity_role" target="attr_role_desc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
