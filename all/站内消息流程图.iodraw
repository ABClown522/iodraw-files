                <mxCell id="user-submit" value="提交发送请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="380" y="460" width="140" height="50" as="geometry"/>
