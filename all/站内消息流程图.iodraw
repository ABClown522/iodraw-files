                </mxCell>
                
                <!-- 左侧：消息发送流程 -->
                <mxCell id="send-area" value="消息发送流程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
                    <mxGeometry x="80" y="100" width="480" height="620" as="geometry"/>
                </mxCell>
                
                <!-- 发送者 -->
