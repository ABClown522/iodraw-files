        <mxCell id="receiver-query" value="查询未读消息数量&lt;br style=&quot;font-size: 12px;&quot;&gt;(定时轮询)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
