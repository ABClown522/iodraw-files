        <mxCell id="user-submit" value="提交发送请求" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="380" y="460" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="save-db" value="保存消息到数据库&lt;br style=&quot;font-size: 12px;&quot;&gt;(message表)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="230" y="550" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="send-end" value="发送完成" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="260" y="650" width="120" height="50" as="geometry" />
