<mxfile host="www.iodraw.com" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36 Edg/148.0.0.0" version="24.7.17">
  <diagram id="MessageFlow" name="站内消息流程图">
    <mxGraphModel dx="1172" dy="661" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="send-area" value="消息发送流程" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;verticalAlign=top;align=center;" parent="1" vertex="1">
          <mxGeometry x="80" y="100" width="480" height="620" as="geometry" />
        </mxCell>
        <mxCell id="sender-start" value="开始" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="260" y="140" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sender-type" value="消息来源？" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="250" y="220" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="system-trigger" value="系统触发事件：&lt;br style=&quot;font-size: 12px;&quot;&gt;• 库存预警&lt;br style=&quot;font-size: 12px;&quot;&gt;• 采购审批&lt;br style=&quot;font-size: 12px;&quot;&gt;• 入库通知&lt;br style=&quot;font-size: 12px;&quot;&gt;• 出库通知" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;" parent="1" vertex="1">
          <mxGeometry x="120" y="340" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="system-create" value="系统自动创建消息" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="120" y="460" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="user-input" value="用户填写消息：&lt;br style=&quot;font-size: 12px;&quot;&gt;• 接收人&lt;br style=&quot;font-size: 12px;&quot;&gt;• 消息标题&lt;br style=&quot;font-size: 12px;&quot;&gt;• 消息内容" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;" parent="1" vertex="1">
