                </mxCell>
                
                <!-- 系统消息分支 -->
                <mxCell id="system-trigger" value="系统触发事件：&lt;br&gt;• 库存预警&lt;br&gt;• 采购审批&lt;br&gt;• 入库通知&lt;br&gt;• 出库通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;" vertex="1" parent="1">
                    <mxGeometry x="120" y="340" width="140" height="90" as="geometry"/>
                </mxCell>
                
