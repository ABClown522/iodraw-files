<mxfile host="65bd71144e">
    <diagram id="OperationLogFlow" name="操作日志记录流程图">
        <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                
                <!-- 标题 -->
                <mxCell id="title" value="操作日志记录流程图（AOP切面）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
                    <mxGeometry x="384" y="30" width="400" height="40" as="geometry"/>
                </mxCell>
                
                <!-- 泳道：用户 -->
                <mxCell id="user-lane" value="用户" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="80" y="100" width="1000" height="100" as="geometry"/>
                </mxCell>
                
                <mxCell id="user-action" value="执行操作&lt;br&gt;(添加/修改/删除)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="user-lane">
                    <mxGeometry x="40" y="25" width="120" height="50" as="geometry"/>
                </mxCell>
                
                <mxCell id="user-view" value="查看操作结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="user-lane">
                    <mxGeometry x="840" y="25" width="120" height="50" as="geometry"/>
                </mxCell>
                
                <!-- 泳道：Controller层 -->
                <mxCell id="controller-lane" value="Controller层" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="80" y="200" width="1000" height="100" as="geometry"/>
                </mxCell>
                
                <mxCell id="controller-receive" value="接收请求&lt;br&gt;@PostMapping/@PutMapping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="controller-lane">
                    <mxGeometry x="40" y="25" width="120" height="50" as="geometry"/>
                </mxCell>
                
                <mxCell id="controller-call" value="调用Service方法" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="controller-lane">
                    <mxGeometry x="200" y="25" width="120" height="50" as="geometry"/>
                </mxCell>
                
                <mxCell id="controller-return" value="返回Result结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="controller-lane">
                    <mxGeometry x="840" y="25" width="120" height="50" as="geometry"/>
                </mxCell>
                
                <!-- 泳道：AOP切面 -->
                <mxCell id="aop-lane" value="AOP切面层" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="80" y="300" width="1000" height="180" as="geometry"/>
                </mxCell>
                
                <mxCell id="aop-before" value="@Before&lt;br&gt;前置通知&lt;br&gt;(记录开始时间)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="aop-lane">
                    <mxGeometry x="200" y="25" width="120" height="60" as="geometry"/>
                </mxCell>
                
                <mxCell id="aop-after" value="@AfterReturning&lt;br&gt;后置通知&lt;br&gt;(获取返回结果)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="aop-lane">
                    <mxGeometry x="520" y="25" width="120" height="60" as="geometry"/>
                </mxCell>
                
                <mxCell id="aop-extract" value="提取日志信息：&lt;br&gt;• 操作人(从Token)&lt;br&gt;• 操作类型&lt;br&gt;• 操作模块&lt;br&gt;• 操作描述&lt;br&gt;• 请求参数&lt;br&gt;• 返回结果&lt;br&gt;• 执行时长&lt;br&gt;• IP地址" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" vertex="1" parent="aop-lane">
                    <mxGeometry x="680" y="15" width="140" height="150" as="geometry"/>
                </mxCell>
                
                <!-- 泳道：Service层 -->
                <mxCell id="service-lane" value="Service层" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="80" y="480" width="1000" height="100" as="geometry"/>
                </mxCell>
                
                <mxCell id="service-execute" value="执行业务逻辑&lt;br&gt;(添加/修改/删除)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="service-lane">
                    <mxGeometry x="360" y="25" width="120" height="50" as="geometry"/>
                </mxCell>
                
                <mxCell id="service-return" value="返回执行结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="service-lane">
                    <mxGeometry x="520" y="25" width="120" height="50" as="geometry"/>
                </mxCell>
                
                <!-- 泳道：数据库 -->
                <mxCell id="database-lane" value="数据库" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="80" y="580" width="1000" height="120" as="geometry"/>
                </mxCell>
                
                <mxCell id="db-business" value="业务数据表&lt;br&gt;(product/user/等)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="database-lane">
                    <mxGeometry x="360" y="20" width="120" height="80" as="geometry"/>
                </mxCell>
                
                <mxCell id="db-log" value="操作日志表&lt;br&gt;(operation_log)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="database-lane">
                    <mxGeometry x="840" y="20" width="120" height="80" as="geometry"/>
                </mxCell>
                
                <!-- 流程箭头 -->
                <!-- 用户到Controller -->
                <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0066CC;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="user-action" target="controller-receive">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow1-label" value="HTTP请求" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#0066CC;" vertex="1" connectable="0" parent="arrow1">
                    <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
                        <mxPoint x="15" as="offset"/>
                    </mxGeometry>
                </mxCell>
                
                <!-- Controller内部流程 -->
                <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#009900;" edge="1" parent="1" source="controller-receive" target="controller-call">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                
                <!-- Controller到AOP Before -->
                <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#CC0000;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="controller-call" target="aop-before">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow3-label" value="切面拦截" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#CC0000;" vertex="1" connectable="0" parent="arrow3">
                    <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
                        <mxPoint x="15" as="offset"/>
                    </mxGeometry>
                </mxCell>
                
                <!-- AOP Before到Service -->
                <mxCell id="arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#009900;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="aop-before" target="service-execute">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="340" y="460"/>
                            <mxPoint x="500" y="460"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="arrow4-label" value="执行目标方法" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#009900;" vertex="1" connectable="0" parent="arrow4">
                    <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
                        <mxPoint x="20" y="-10" as="offset"/>
                    </mxGeometry>
                </mxCell>
                
                <!-- Service到数据库 -->
                <mxCell id="arrow5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0066CC;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="service-execute" target="db-business">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow5-label" value="操作数据" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#0066CC;" vertex="1" connectable="0" parent="arrow5">
                    <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
                        <mxPoint x="15" as="offset"/>
                    </mxGeometry>
                </mxCell>
                
                <!-- 数据库返回到Service -->
                <mxCell id="arrow6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FF6600;dashed=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="db-business" target="service-return">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="500" y="600"/>
                            <mxPoint x="600" y="600"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="arrow6-label" value="返回结果" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#FF6600;" vertex="1" connectable="0" parent="arrow6">
                    <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
                        <mxPoint x="15" y="10" as="offset"/>
                    </mxGeometry>
                </mxCell>
                
                <!-- Service返回到AOP After -->
                <mxCell id="arrow7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FF6600;dashed=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="service-return" target="aop-after">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow7-label" value="方法返回" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#FF6600;" vertex="1" connectable="0" parent="arrow7">
                    <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
                        <mxPoint x="15" as="offset"/>
                    </mxGeometry>
                </mxCell>
                
                <!-- AOP After到Extract -->
                <mxCell id="arrow8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9933FF;" edge="1" parent="1" source="aop-after" target="aop-extract">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow8-label" value="提取信息" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#9933FF;" vertex="1" connectable="0" parent="arrow8">
                    <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
                        <mxPoint y="-10" as="offset"/>
                    </mxGeometry>
                </mxCell>
                
                <!-- Extract到日志数据库 -->
                <mxCell id="arrow9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#CC0000;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="aop-extract" target="db-log">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="830" y="560"/>
                            <mxPoint x="1000" y="560"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="arrow9-label" value="异步保存日志" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#CC0000;" vertex="1" connectable="0" parent="arrow9">
                    <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
                        <mxPoint x="20" y="-10" as="offset"/>
                    </mxGeometry>
                </mxCell>
                
                <!-- AOP返回到Controller -->
                <mxCell id="arrow10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FF6600;dashed=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="aop-after" target="controller-return">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="660" y="280"/>
                            <mxPoint x="1000" y="280"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="arrow10-label" value="继续返回" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#FF6600;" vertex="1" connectable="0" parent="arrow10">
                    <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
                        <mxPoint x="30" y="10" as="offset"/>
                    </mxGeometry>
                </mxCell>
                
                <!-- Controller返回到用户 -->
                <mxCell id="arrow11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#FF6600;dashed=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="controller-return" target="user-view">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow11-label" value="HTTP响应" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#FF6600;" vertex="1" connectable="0" parent="arrow11">
                    <mxGeometry x="-0.2" y="1" relative="1" as="geometry">
                        <mxPoint x="15" as="offset"/>
                    </mxGeometry>
                </mxCell>
                
                <!-- 说明文本框 -->
                <mxCell id="note1" value="&lt;b&gt;AOP切面优势：&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 无侵入性：业务代码无需修改&lt;br&gt;2. 统一管理：集中处理日志逻辑&lt;br&gt;3. 易于维护：修改日志规则只需改切面&lt;br&gt;4. 异步处理：不影响业务性能&lt;br&gt;5. 灵活配置：通过注解控制记录范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
                    <mxGeometry x="80" y="720" width="280" height="60" as="geometry"/>
                </mxCell>
                
                <mxCell id="note2" value="&lt;b&gt;日志记录内容：&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 操作人：从Token获取用户信息&lt;br&gt;• 操作类型：增/删/改/查&lt;br&gt;• 操作模块：商品/用户/入库等&lt;br&gt;• 操作描述：具体操作说明&lt;br&gt;• 请求参数：JSON格式&lt;br&gt;• 返回结果：成功/失败&lt;br&gt;• 执行时长：毫秒&lt;br&gt;• IP地址：客户端IP&lt;br&gt;• 操作时间：精确到秒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
                    <mxGeometry x="400" y="720" width="280" height="60" as="geometry"/>
                </mxCell>
                
                <mxCell id="note3" value="&lt;b&gt;流程说明：&lt;/b&gt;&lt;br&gt;&lt;br&gt;━━ 请求流程&lt;br&gt;┄┄ 响应流程&lt;br&gt;&lt;br&gt;切面在方法执行前后自动拦截，&lt;br&gt;提取信息并异步保存到数据库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
                    <mxGeometry x="720" y="720" width="360" height="60" as="geometry"/>
                </mxCell>
                
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
