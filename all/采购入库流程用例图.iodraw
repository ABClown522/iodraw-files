<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="采购入库流程用例图">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" pageWidth="1800" pageHeight="1200">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 标题 -->
        <mxCell id="title" value="采购入库流程用例图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="20" width="500" height="40" as="geometry"/>
        </mxCell>

        <!-- 系统边界 -->
        <mxCell id="system_boundary" value="采购入库流程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=3;fontSize=16;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="1000" height="1000" as="geometry"/>
        </mxCell>

        <!-- 参与者 -->
        <!-- 采购人员 -->
        <mxCell id="actor_purchase" value="采购人员" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#000000;fontSize=14;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="180" y="300" width="80" height="160" as="geometry"/>
        </mxCell>

        <!-- 仓库管理员 -->
        <mxCell id="actor_warehouse" value="仓库管理员" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#000000;fontSize=14;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="180" y="750" width="80" height="160" as="geometry"/>
        </mxCell>

        <!-- 用例 - 采购流程 -->
        <mxCell id="uc_create_purchase" value="创建采购单" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="550" y="200" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="uc_query_purchase" value="查询采购单" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="550" y="320" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="uc_confirm_purchase" value="采购单入库确认" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="550" y="440" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- 用例 - 入库流程 -->
        <mxCell id="uc_instore" value="确认入库" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="550" y="680" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="uc_query_instore" value="查询入库单" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="550" y="800" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- 用例 - 辅助功能 -->
        <mxCell id="uc_create_instore" value="创建入库单" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="440" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="uc_update_inventory" value="更新库存" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="600" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="uc_check_product" value="查询商品记录" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="760" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="uc_select_supplier" value="选择供应商" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="850" y="200" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- 关联关系 - 采购人员 -->
        <mxCell id="link_purchase_1" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="actor_purchase" target="uc_create_purchase">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="link_purchase_2" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="actor_purchase" target="uc_query_purchase">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="link_purchase_3" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="actor_purchase" target="uc_confirm_purchase">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 关联关系 - 仓库管理员 -->
        <mxCell id="link_warehouse_1" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="actor_warehouse" target="uc_instore">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="link_warehouse_2" value="" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="actor_warehouse" target="uc_query_instore">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 包含关系 (include) -->
        <mxCell id="include_1" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;fontSize=12;" edge="1" parent="1" source="uc_create_purchase" target="uc_select_supplier">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="include_3" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;fontSize=12;" edge="1" parent="1" source="uc_confirm_purchase" target="uc_create_instore">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="include_4" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;fontSize=12;" edge="1" parent="1" source="uc_instore" target="uc_update_inventory">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="include_5" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;fontSize=12;" edge="1" parent="1" source="uc_instore" target="uc_check_product">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 依赖关系 -->
        <mxCell id="depend_1" value="" style="endArrow=open;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;fontSize=12;" edge="1" parent="1" source="uc_query_purchase" target="uc_create_purchase">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
